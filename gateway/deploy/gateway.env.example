# This file is read by systemd, not executed by a shell. Keep it root:burrow 0640.
# Do not put secrets in unit files, URLs, logs, or process command lines.
# Configure the outbound TLS controller endpoint and a stable node-goblin identity.
BURROW_GATEWAY_CONTROLLER_URL=tls://controller.example:7443
BURROW_GATEWAY_ID=replace-with-your-gateway-id

# First enrollment only: provision this value out of band in this protected file,
# start the service once, then remove it. Trust is persisted in the state directory.
# BURROW_GATEWAY_ENROLLMENT_TOKEN=

# TLS trust material must be files readable by the burrow account, never inline PEM.
# BURROW_GATEWAY_CA_FILE=/etc/burrow-host-gateway/controller-ca.pem
# BURROW_GATEWAY_CERT_FILE=/etc/burrow-host-gateway/node-goblin-cert.pem
# BURROW_GATEWAY_KEY_FILE=/etc/burrow-host-gateway/node-goblin-key.pem

# Optional only for first Node Goblin pairing against an automatically generated
# controller certificate. Compare and approve the pairing transcript code; the
# approved controller certificate is pinned locally. Set this CA for strict TLS
# from the first connection and for existing HMAC/enrollment deployments.
# BURROW_GATEWAY_CA_FILE=/etc/burrow/controller-ca.pem
